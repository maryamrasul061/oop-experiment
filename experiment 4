#include <iostream>
using namespace std;

class Book {
private:
    string title;
    string author;

public:
    void getData() {
        cout << "Enter Title: ";
        cin >> title;

        cout << "Enter Author: ";
        cin >> author;
    }

    void display() {
        cout << "Title: " << title << endl;
        cout << "Author: " << author << endl;
    }
};

int main() {
    Book b;
    b.getData();
    b.display();

    return 0;
}
